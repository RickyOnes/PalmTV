{
  "app": {
    // ★★★ 签名请自备，本文件只保留结构 ★★★
    //   DevEco Studio → File → Project Structure → Signing Configs →
    //   勾选 "Automatically generate signature"（会自动写入 signingConfigs 与 products 的引用）。
    //   ⚠️ 仓库内**不包含**任何证书 / 密钥库 / Profile（`Profile/` 已被 .gitignore 排除）。
    "signingConfigs": [
      {
        "name": "default",
        "type": "HarmonyOS",
        "material": {
          "storeFile": "./Profile/YOUR_KEYSTORE.p12",
          "storePassword": "YOUR_STORE_PASSWORD",
          "keyAlias": "YOUR_KEY_ALIAS",
          "keyPassword": "YOUR_KEY_PASSWORD",
          "signAlg": "SHA256withECDSA",
          "profile": "./Profile/YOUR_PROFILE.p7b",
          "certpath": "./Profile/YOUR_CERT.cer"
        }
      }
    ],
    // ================================================================================
    // 产品（product）× 构建模式（buildMode）= DevEco 右上角的"构建变体"下拉
    //
    //   | 产品     | 构建模式  | 用途                                     | 混淆 | 能 hdc 直装 |
    //   |---------|----------|-----------------------------------------|------|-----------|
    //   | default | debug    | 日常真机调试（全量日志）                    | 关   | ✅ |
    //   | default | release  | 混淆后真机自测（验证混淆版还能跑）           | 开   | ✅ |
    //   | release | release  | 对外分发（发布证书，只能走应用市场内测）      | 开   | ❌ |
    // ================================================================================
    "products": [
      {
        "name": "default",
        // ★ 必须显式引用 signingConfigs 里的条目，否则产物是 entry-*-unsigned.hap
        "signingConfig": "default",
        "targetSdkVersion": "6.1.1(24)",
        "compatibleSdkVersion": "6.1.0(23)",
        "runtimeOS": "HarmonyOS",
        "buildOption": {
          "strictMode": {
            "caseSensitiveCheck": true,
            "useNormalizedOHMUrl": true
          }
        }
      },
      {
        "name": "release",
        // ★ 对外包：请把这里换成你自己的发布证书配置（或同样用 "default" 走调试签名自测）
        "signingConfig": "default",
        "targetSdkVersion": "6.1.1(24)",
        "compatibleSdkVersion": "6.1.0(23)",
        "runtimeOS": "HarmonyOS",
        "buildOption": {
          "strictMode": {
            "caseSensitiveCheck": true,
            "useNormalizedOHMUrl": true
          },
          // 正式版剔除模拟器用的 x86_64（真机只有 arm64-v8a）
          "nativeLib": {
            "filter": {
              "excludes": [
                "**/x86_64/**"
              ]
            }
          }
        }
      }
    ],
    "buildModeSet": [
      {
        "name": "debug"
      },
      {
        "name": "release"
      }
    ]
  },
  "modules": [
    {
      "name": "entry",
      "srcPath": "./entry",
      "targets": [
        {
          "name": "default",
          "applyToProducts": [
            "default",
            "release"
          ]
        }
      ]
    }
  ]
}
