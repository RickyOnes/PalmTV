{
  "apiType": "stageMode",
  "buildOption": {
    // ★ 接入 native 解密模块（libcmg_napi.so）
    //   CMake 源在 entry/src/main/cpp/CMakeLists.txt，它引用 hmnative/native/ 的 gate1 内核。
    "externalNativeOptions": {
      "path": "./src/main/cpp/CMakeLists.txt",
      "arguments": "",
      "cppFlags": "",
      "abiFilters": [
        "arm64-v8a"
      ]
    }
  },
  "buildOptionSet": [
    {
      "name": "release",
      "arkOptions": {
        "obfuscation": {
          "ruleOptions": {
            "enable": true,
            "files": [
              "./obfuscation-rules.txt"
            ]
          }
        }
      }
    }
  ],
  "targets": [
    {
      "name": "default"
    },
    {
      "name": "ohosTest"
    }
  ]
}
