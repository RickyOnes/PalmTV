<Window x:Class="PalmTVDesktop.IptvSourceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="自定义 IPTV 源"
        Height="580" Width="700" MinHeight="460" MinWidth="580"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgColor}"
        Foreground="{StaticResource TextColor}"
        FontSize="12">
    <!--
      ★ 2026-09-29：关于页「添加 / 编辑自定义源…」的编辑窗。
        数据落到 `%LOCALAPPDATA%\WinPalmTV\iptv-local.m3u`（见 IptvChannels.UserPath）；
        保存后由 MainWindow 重新载入频道列表（不重启）。
        内置清单（程序里的 15 条）**只读**，不会被这里改写。

      ★★ 2026-10-02（用户要求"与移动端同步"）★★ 三处改动：
        ① **列表行显示序号** + 样式与移动端一致：`1. 频道名    地址`（单行、超长省略），
           选中行 = 蓝底白字、未选中 = 浅灰（`#bbbbbb`）、行内边距 6/7、圆角 4 —— 与安卓/鸿蒙逐项对齐；
           ⚠️ 刷新方式也换了：不再靠 `Row.ToString()`（属性变更**不会**让 ListBox 重绘，
           老代码只好"整项替换"打补丁），改成 `INotifyPropertyChanged` ⇒ 「更新选中」**当场**更新列表。
        ② **新增「从 m3u 文本导入」**（与安卓/鸿蒙同功能）：折叠入口 + 多行粘贴框 + 导入到列表 / 关闭。
        ③ **按钮按职责分三档**（用户原话"不要全是蓝色背景，要专业点以示区分"）：
           实心强调色 = 主操作（添加到列表 / 导入到列表 / 保存并生效）
           深色填充   = 次要操作（更新选中 / 关闭 / 取消）
           透明+描边  = 危险操作（删除选中，红字红描边）
           ⚠️ 桌面端主题色是**红**（`AccentColor #E94560`），所以"主操作"是红填充、"危险"用**描边**区分，
             靠"实心 / 描边"拉开层级（三端语义一致，颜色各自取本端主题）。
    -->
    <Window.Resources>
        <!-- 主操作：实心强调色填充 -->
        <Style x:Key="IptvPrimaryStyle" TargetType="Button" BasedOn="{StaticResource CtrlBtnStyle}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Background" Value="{StaticResource AccentColor}"/>
        </Style>
        <!-- 次要操作：深色填充（沿用全局按钮观感，只把字号收到 12） -->
        <Style x:Key="IptvGhostStyle" TargetType="Button" BasedOn="{StaticResource CtrlBtnStyle}">
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <!-- 危险操作：透明底 + 1px 描边（描边色/字色由各按钮自己给，见下方"删除选中"） -->
        <Style x:Key="IptvOutlineStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FF7A8A"/>
            <Setter Property="BorderBrush" Value="#7A3546"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" TextWrapping="Wrap" Foreground="#bbbbbb"
                   Text="填写电视台/运营方公开发布的直播直链（.m3u8 或 .ts）。支持多路，保存后立即生效、无需重启。"/>

        <!-- 列表（点一条即选中并回填输入框）—— 样式与移动端一致：选中蓝底白字、行内联序号 -->
        <Border Grid.Row="1" Margin="0,10,0,10" Background="{StaticResource PanelColor}" CornerRadius="4">
            <ListBox x:Name="SourceList" Margin="4" Background="Transparent" BorderThickness="0"
                     Foreground="{StaticResource TextColor}" FontSize="12"
                     HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     SelectionChanged="SourceList_SelectionChanged">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Foreground" Value="#bbbbbb"/>
                        <Setter Property="Padding" Value="6,7"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="RowBg" Background="{TemplateBinding Background}"
                                            CornerRadius="4" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <!-- 选中：蓝底白字（移动端同款 #2f6bff） -->
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="RowBg" Property="Background" Value="#2F6BFF"/>
                                            <Setter Property="Foreground" Value="#ffffff"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="RowBg" Property="Background" Value="#22304F"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <!-- 单行显示；超长省略（与移动端 maxLines(1) + Ellipsis 一致） -->
                        <TextBlock Text="{Binding Text}" TextTrimming="CharacterEllipsis"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="频道名" VerticalAlignment="Center" Margin="0,0,6,8"/>
            <TextBox Grid.Row="0" Grid.Column="1" x:Name="NameBox" Height="26" Margin="0,0,12,8"
                     Background="#0F3460" Foreground="#EEEEEE" BorderThickness="0"
                     VerticalContentAlignment="Center" Padding="6,0" ToolTip="留空则自动取域名"/>

            <TextBlock Grid.Row="0" Grid.Column="2" Text="播放地址" VerticalAlignment="Center" Margin="0,0,6,8"/>
            <TextBox Grid.Row="0" Grid.Column="3" x:Name="UrlBox" Height="26" Margin="0,0,0,8"
                     Background="#0F3460" Foreground="#EEEEEE" BorderThickness="0"
                     VerticalContentAlignment="Center" Padding="6,0"
                     ToolTip="http:// 或 https:// 开头的直播直链"/>

            <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4" Orientation="Horizontal">
                <Button Content="添加到列表" Height="28" Padding="12,0"
                        Style="{StaticResource IptvPrimaryStyle}" Click="Add_Click"/>
                <Button Content="更新选中" Height="28" Padding="12,0" Margin="8,0,0,0"
                        Style="{StaticResource IptvGhostStyle}" Click="Update_Click"/>
                <Button Content="删除选中" Height="28" Padding="12,0" Margin="8,0,0,0"
                        Style="{StaticResource IptvOutlineStyle}" Click="Remove_Click"/>
            </StackPanel>
        </Grid>

        <!-- 从 m3u 文本导入（★ 2026-10-02 新增；与安卓/鸿蒙同功能）：默认折叠 -->
        <StackPanel Grid.Row="3" Margin="0,12,0,0">
            <TextBlock x:Name="ImportToggle" Text="从 m3u 文本导入 ▾" Foreground="#8AB4FF"
                       Cursor="Hand" MouseLeftButtonUp="ImportToggle_Click"/>
            <StackPanel x:Name="ImportPanel" Visibility="Collapsed" Margin="0,6,0,0">
                <TextBox x:Name="ImportBox" Height="76" AcceptsReturn="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                         Background="#0F3460" Foreground="#EEEEEE" BorderThickness="0" Padding="6,4"
                         ToolTip="把 m3u 内容粘到这里（可多行：#EXTINF:-1,频道名 换行 地址）"/>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <Button Content="导入到列表" Height="28" Padding="12,0"
                            Style="{StaticResource IptvPrimaryStyle}" Click="ImportDo_Click"/>
                    <Button Content="关闭" Height="28" Padding="12,0" Margin="8,0,0,0"
                            Style="{StaticResource IptvGhostStyle}" Click="ImportClose_Click"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="取消" Width="90" Height="30" Margin="0,0,10,0"
                    Style="{StaticResource IptvGhostStyle}" Click="Cancel_Click"/>
            <Button Content="保存并生效" Width="130" Height="30"
                    Style="{StaticResource IptvPrimaryStyle}" Click="Save_Click"/>
        </StackPanel>

        <TextBlock Grid.Row="5" x:Name="HintText" Margin="0,12,0,0" FontSize="11"
                   Foreground="#8a8a8a" TextWrapping="Wrap"/>
    </Grid>
</Window>
