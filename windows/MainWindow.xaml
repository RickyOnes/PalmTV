<Window x:Class="PalmTVDesktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="掌上电视" Height="580" Width="1100"
        MinHeight="450" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        KeyDown="Window_KeyDown" Loaded="Window_Loaded">
    <Window.Resources>
        <!-- 全局按钮: 深色悬浮替代系统亮蓝 -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#0F3460"/>
            <Setter Property="Foreground" Value="#EEE"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <Grid>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Border x:Name="hl" CornerRadius="3" Background="#28FFFFFF" Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="hl" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 深色滚动条 (全局) -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="#16213E"/>
            <Setter Property="Width" Value="8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid>
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb Background="#445566" BorderThickness="0" Width="8">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="4"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 自定义 MenuItem 模板: 去掉左侧图标列 + 深色背景 + 深色高亮 -->
        <Style x:Key="DarkMenuItem" TargetType="MenuItem">
            <Setter Property="Background" Value="#16213E"/>
            <Setter Property="Foreground" Value="#CCC"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderThickness="0"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Grid.Column="0" ContentSource="Header" RecognizesAccessKey="True"
                                                  VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" x:Name="SubArrow" Text="▸" FontSize="10"
                                           Foreground="#888" VerticalAlignment="Center" Margin="8,0,0,0"
                                           Visibility="Collapsed"/>
                                <Popup Grid.Column="0" Grid.ColumnSpan="2" x:Name="PART_Popup"
                                       IsOpen="{Binding IsSubmenuOpen,RelativeSource={RelativeSource TemplatedParent}}"
                                       AllowsTransparency="True" Focusable="False" PopupAnimation="None"
                                       Placement="Right" VerticalOffset="-4">
                                    <Border Background="#16213E" BorderBrush="#0F3460" BorderThickness="1" Padding="2">
                                        <ItemsPresenter/>
                                    </Border>
                                </Popup>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#0F3460"/>
                            </Trigger>
                            <Trigger Property="IsSubmenuOpen" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#0F3460"/>
                            </Trigger>
                            <Trigger Property="HasItems" Value="True">
                                <Setter TargetName="SubArrow" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="Role" Value="TopLevelHeader">
                                <Setter TargetName="SubArrow" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DarkMenu" TargetType="ContextMenu">
            <Setter Property="Background" Value="#16213E"/>
            <Setter Property="BorderBrush" Value="#0F3460"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DarkSeparator" TargetType="Separator">
            <Setter Property="Background" Value="#16213E"/>
            <Setter Property="Height" Value="0"/>
        </Style>
        <!-- 自定义提示框 -->
        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="#16213E"/>
            <Setter Property="Foreground" Value="#EEE"/>
            <Setter Property="BorderBrush" Value="#0F3460"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" GlassFrameThickness="0" CornerRadius="10"
                      ResizeBorderThickness="4" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Border x:Name="OuterBorder" Background="#1A1A2E" CornerRadius="10" BorderBrush="#16213E" BorderThickness="1">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition x:Name="TitleBarRow" Height="36"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===== 自定义标题栏 ===== -->
        <Border Grid.Row="0" Background="#16213E" CornerRadius="10,10,0,0"
                MouseLeftButtonDown="TitleBar_Drag">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                    <Image x:Name="TitleIcon" Width="24" Height="24" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <!-- ★ 2026-10-02（用户要求：三端一致，应用名只留中文）原来这里写 "PalmTV" -->
                    <TextBlock Text="掌上电视" FontSize="15" FontWeight="Bold"
                               Foreground="#E94560" VerticalAlignment="Center"/>
                </StackPanel>
                <!-- 标题栏右侧: 底栏中排列3个按钮 -->
                <Grid HorizontalAlignment="Right">
                    <StackPanel Orientation="Horizontal" Margin="2,4,4,4">
                        <Button x:Name="BtnMinimize" Content="─" Width="32" Height="32" Click="BtnMinimize_Click"
                                Background="Transparent" Foreground="#AAA" BorderThickness="0" Cursor="Hand"
                                FontSize="14" Padding="0"
                                MouseEnter="TitleBtn_MouseEnter" MouseLeave="TitleBtn_MouseLeave">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="Transparent" CornerRadius="4">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#2A2D3E"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button x:Name="BtnMaxRestore" Content="□" Width="32" Height="32" Click="BtnMaxRestore_Click"
                                Background="Transparent" Foreground="#AAA" BorderThickness="0" Cursor="Hand"
                                FontSize="14" Padding="0"
                                MouseEnter="TitleBtn_MouseEnter" MouseLeave="TitleBtn_MouseLeave">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="Transparent" CornerRadius="4">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#2A2D3E"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button x:Name="BtnClose" Content="✕" Width="32" Height="32" Click="BtnClose_Click"
                                Background="Transparent" Foreground="#E94560" BorderThickness="0" Cursor="Hand"
                                FontSize="14" Padding="0"
                                MouseEnter="TitleBtn_MouseEnter" MouseLeave="TitleBtn_MouseLeave">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="Transparent" CornerRadius="4">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#E81123"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- ★★ 侧栏 264 = 按"圆 72"反推，且按**有滚动条的最坏情况**取：
                     可用 = 264 − 网格边距 16 − 滚动条 17 = 231 ⇒ 每格 231/3 = 77 > 75 ✓ 圆固定 72。
                     全屏时没有滚动条（每格 ~82）、圆仍 72 ⇒ 两模式瓷砖尺寸一致，只多留白。
                     ⚠️ 侧栏宽与"圆 / 图片框 / 裁剪圆"是**联动解出来的一组数**，改一个必须重算全部（见注释）。
                     ⚠️ 代码里 ToggleFullscreen / ApplyFullscreenUI 恢复侧栏时**必须用启动时记下的宽度**
                        （`_sidebarWidth`）—— 旧代码写死 192，切一次全屏就把网格压变形。 -->
                <!-- ★★ 2026-11-06：对齐安卓横屏（MainScreen.kt:104-118 / TvHomeScreen.kt:450-474）★★
                     左 68% = 状态栏 + 视频 + 节目条 + 控制栏；右 32% = 分组 Tab + 频道网格（3 列）。
                     原来左栏是频道区（固定 264px）、右侧视频，与安卓相反。
                     ⚠️ `SidebarCol` 名字保留：全屏切换的代码还在用它（Width=0 隐藏侧栏）。 -->
                <ColumnDefinition Width="70*"/>
                <ColumnDefinition x:Name="SidebarCol" Width="30*"/>
            </Grid.ColumnDefinitions>

            <!-- ★ 2026-11-06：频道区移到右侧（安卓横屏同款） -->
            <Border x:Name="Sidebar" Grid.Column="1" Background="#16213E">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>   <!-- 搜索框 -->
                        <RowDefinition Height="Auto"/>   <!-- 分组 tab：综合 / 卫视 / 地方台 -->
                        <RowDefinition Height="*"/>      <!-- 台标瓷砖网格 -->
                        <RowDefinition Height="Auto"/>   <!-- 状态栏 -->
                    </Grid.RowDefinitions>

                    <TextBox x:Name="SearchBox" Grid.Row="0" Margin="0,0,0,6" Height="28"
                             Background="#0F3460" Foreground="#888" CaretBrush="#E94560"
                             BorderThickness="0"
                             TextChanged="SearchBox_TextChanged"
                             GotFocus="SearchBox_GotFocus" LostFocus="SearchBox_LostFocus"
                             FontSize="12" Padding="6,4" Text="🔍 搜索频道..."/>

                    <!-- ★ 分组 tab（与鸿蒙 PalmTV 分组方式一致）：央视 / 卫视 / 地方台 / **关于**
                         ⚠️ **Columns 必须等于 Tab 个数**：写成 3 而挂了 4 个按钮时，第 4 个会换到第二行、
                         被下方 Grid.Row=2 的台标网格盖住（用户实测"关于看不到、被台标挡住"）。 -->
                    <UniformGrid Grid.Row="1" Rows="1" Columns="4" Margin="0,0,0,6">
                        <UniformGrid.Resources>
                            <Style x:Key="TabBtn" TargetType="ToggleButton">
                                <Setter Property="Height" Value="26"/>
                                <Setter Property="FontSize" Value="11"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Margin" Value="1,0"/>
                                <Setter Property="Foreground" Value="#9AA7BF"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="bd" CornerRadius="5" Background="#121828"
                                                    BorderThickness="1" BorderBrush="#22304D">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#1E2A47"/>
                                                </Trigger>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#E94560"/>
                                                    <Setter TargetName="bd" Property="BorderBrush" Value="#FF6B85"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </UniformGrid.Resources>
                        <ToggleButton x:Name="TabCctv" Content="央视"   Tag="cctv"      IsChecked="True"
                                      Style="{StaticResource TabBtn}" Click="ChannelTab_Click"/>
                        <ToggleButton x:Name="TabSat"  Content="卫视"   Tag="satellite"
                                      Style="{StaticResource TabBtn}" Click="ChannelTab_Click"/>
                        <ToggleButton x:Name="TabLocal" Content="地方台" Tag="local"
                                      Style="{StaticResource TabBtn}" Click="ChannelTab_Click"/>
                        <!-- ★ 2026-09-24：与鸿蒙端对齐的第 4 个 Tab（关于页） -->
                        <ToggleButton x:Name="TabAbout" Content="关于" Tag="about"
                                      Style="{StaticResource TabBtn}" Click="ChannelTab_Click"/>
                    </UniformGrid>

                    <!-- ★★ 关于页（与频道网格**同格互斥**显示；内容与鸿蒙端一致） -->
                    <ScrollViewer x:Name="AboutPanel" Grid.Row="2" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
                        <StackPanel Margin="12,6,12,16">
                            <StackPanel Orientation="Horizontal">
                                <!-- ★★ 2026-10-02（用户要求：三端一致）★★
                                     品牌区左侧改成**应用图标**（`app_icon.png`，原来这里放的是版权图标）；
                                     版权图标移到「版权人：飘渺峰」后面、16px **圆角矩形**（与安卓/鸿蒙同位置同尺寸）。 -->
                                <Image x:Name="AboutIcon" Width="48" Height="48" VerticalAlignment="Center"/>
                                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="掌上电视" FontSize="16" FontWeight="SemiBold" Foreground="White"/>
                                    <TextBlock x:Name="AboutVersion" FontSize="12" Foreground="#8a8a8a" Margin="0,2,0,0"/>
                                    <TextBlock Text="桌面版 · WinPalmTV" FontSize="11" Foreground="#666666" Margin="0,2,0,0"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                        <TextBlock Text="版权人：飘渺峰" FontSize="11" Foreground="#666666" VerticalAlignment="Center"/>
                                        <Image x:Name="AboutCopyrightIcon" Width="16" Height="16" Margin="5,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>

                            <TextBlock Text="技术说明" FontSize="12" Foreground="#2f6bff" Margin="0,12,0,3"/>
                            <TextBlock FontSize="12" Foreground="#bbbbbb" TextWrapping="Wrap"
                                       Text="· 客户端：C# / WPF（界面与取流编排）&#x0a;· 播放器：libVLC（原生播放）&#x0a;· 数据来源：各电视台/内容方公开发布的直播地址"/>
                            <!-- ★ 2026-09-29：自定义 IPTV 源 = 技术说明的**第 4 个要点**（同字号、同行距、带 · 符号）。
                                 详细说明放在弹窗里（IptvSourceWindow）；条目数放进按钮 ToolTip
                                 （侧栏太窄，行内那串数字会被截断 ⇒ 不再单列一行）。 -->
                            <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                                <TextBlock Text="· 支持自定义 IPTV 源" FontSize="12" Foreground="#bbbbbb"
                                           VerticalAlignment="Center"/>
                                <Button x:Name="BtnIptvSource" Content="添加 / 编辑" FontSize="11"
                                        Height="20" Width="78" Margin="8,0,0,0" Cursor="Hand"
                                        Style="{StaticResource CtrlBtnStyle}"
                                        Background="{StaticResource AccentColor}" Foreground="White"
                                        Click="AboutIptv_Click"
                                        ToolTip="添加自己的直播直链（m3u8 / ts）；保存后立即生效"/>
                            </StackPanel>

                            <TextBlock Text="账号与登录" FontSize="12" Foreground="#2f6bff" Margin="0,12,0,3"/>
                            <!-- ★ 2026-10-02（用户要求：两个登录按钮**并排等大**）：
                                 原来用 StackPanel（按内容宽度自适应 ⇒ 两个不等宽）⇒ 改成两列等宽的 Grid（与安卓 `weight(1f)` 同口径）。 -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="BtnWechatLogin" Grid.Column="0" Content="微信登录" Foreground="White"
                                        Background="#07c160" BorderThickness="0" Padding="14,6" Cursor="Hand"
                                        HorizontalAlignment="Stretch" Click="AboutLogin_Click"/>
                                <Button x:Name="BtnHuaweiLogin" Grid.Column="1" Content="华为账号登录" Foreground="White"
                                        Background="#cf0a2c" BorderThickness="0" Padding="14,6" Margin="10,0,0,0"
                                        Cursor="Hand" HorizontalAlignment="Stretch" Click="AboutLogin_Click"/>
                            </Grid>
                            <TextBlock FontSize="11" Foreground="#8a8a8a" TextWrapping="Wrap" Margin="0,6,0,0"
                                       Text="· 登录用于跨设备同步「收藏」与偏好；未登录也可正常观看&#x0a;· 收藏、登录同步将在后续版本提供"/>

                            <TextBlock Text="内容来源与免责" FontSize="12" Foreground="#2f6bff" Margin="0,12,0,3"/>
                            <!-- ★ 2026-09-29：链接色**不再**用小节标题那个蓝（#2f6bff）——与"举报/联系"的邮箱同色系，
                                 一眼能看出"这是可点的"（用户反馈：与标题同色分不清）。 -->
                            <TextBlock x:Name="AboutDisclaimerLink" Text="查看完整声明 >" FontSize="12" Foreground="#8ab4ff"
                                       Cursor="Hand" MouseLeftButtonUp="AboutDisclaimer_Click"/>

                            <TextBlock Text="举报 / 联系" FontSize="12" Foreground="#2f6bff" Margin="0,12,0,3"/>
                            <TextBlock x:Name="AboutContact" FontSize="13" Foreground="#8ab4ff" Cursor="Hand"
                                       ToolTip="点击复制" MouseLeftButtonUp="AboutContact_Click"/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ★ 台标瓷砖网格（无台标图片时自动退化为文字瓷砖） -->
                    <ScrollViewer x:Name="ChannelScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <!-- ★ VerticalAlignment=Top：分组内台标少时（如地方台只有 3 行），不要被 UniformGrid
                             把行高均分撑满整个可视区（否则行与行之间出现巨大空白）；剩余空间留在下方 -->
                        <ItemsControl x:Name="ChannelGrid" VerticalAlignment="Top">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <!-- ★ 固定 3 列（与鸿蒙横屏 `columnsTemplate('1fr 1fr 1fr')` 一致）：
                                         原来用 WrapPanel，被滚动条吃掉宽度后只排得下 2 列 ⇒ 64 个台要滚很久 -->
                                    <UniformGrid Columns="3"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!-- ★ 只显示台标（按用户要求：不再显示下方频道文字；完整台名在 ToolTip 里） -->
                                    <Grid Height="76" Margin="1,2" Cursor="Hand" ToolTip="{Binding Name}"
                                          MouseLeftButtonUp="ChannelTile_Click"
                                          MouseRightButtonUp="ChannelTile_RightClick">
                                        <!-- ★ 台标圆环：**白底**（对齐鸿蒙 `channelIconItem` 的 '#ffffff'）
                                             + 在播 `#ff3b3b` 红外圈 / 选中青圈 / 其余 `#3a3a3a` 灰圈
                                             外径 **72** − 边框 2×2 ⇒ 内部白圆直径 68（半径 34） -->
                                        <Border x:Name="TileRing" Width="72" Height="72" CornerRadius="36"
                                                BorderThickness="2" BorderBrush="#3A3A3A" Background="#FFFFFF"
                                                HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Grid>
                                                <!-- ★★ 2026-10-02（用户："自定义频道在本地生成文本台标后，要显示全部频道名，
                                                     而不是现在的一个"）★★ 文字台标 = **完整频道名**（原来 `ShortName` 只有一个字/一段）：
                                                       · 宽度 58 ≈ 0.85×内圆径 68（留边距的可用弦长）⇒ 换行位置正好；
                                                       · 字号与最大高度由 `ChannelTile.FallbackFontSize / FallbackMaxHeight`
                                                         按"字数 → 每行几个字 → 字号"反推（与安卓/鸿蒙同一套数）；
                                                       · `TextTrimming=CharacterEllipsis` + MaxHeight ⇒ 最多两行、超出省略。 -->
                                                <TextBlock x:Name="TileFallback" Text="{Binding FallbackText}"
                                                           FontSize="{Binding FallbackFontSize}"
                                                           MaxHeight="{Binding FallbackMaxHeight}"
                                                           Width="58" Foreground="#333333"
                                                           TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                                           TextAlignment="Center"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <!-- ★★ 图片框 57×36 —— 一组联立解出来的数：★★
                                                     约束：① 图案四角必须落在白圆内（否则"露出圆外"）；
                                                          ② 台标两类原始比例，**台名常印在图里**（央视 144×72 ≈2.37:1；卫视/本地 144×100=1.44:1）；
                                                          ③ 框要足够大，让两类都**各自达到几何上限**（否则冤白留边）。
                                                     圆半径 R=34、留 ~3px 余量 ⇒ 等效 R=31：
                                                       央视 2.37:1 角距 = s·√(71²+30²)=77.1s ≤ 31 ⇒ s ≤ 0.402 ⇒ 需框宽 ≥ 57.1、高 ≥ 24.1
                                                       卫视/本地 1.44:1 角距 = s·√(72²+50²)=87.7s ≤ 31 ⇒ s ≤ 0.3535 ⇒ 需框宽 ≥ 50.9、高 ≥ 35.4
                                                     ⇒ 取 **57×36**：央视落在 57.0×24.1、卫视/本地落在 50.9×35.4，
                                                       两者四角距心都 ≈31 < 34 ✓（余 3px），且都是各自的上限。
                                                     ⚠️ 改圆径必须同步改这三个数：图片框 + 下边 Clip 的圆心/半径。 -->
                                                <Image x:Name="TileLogo" Source="{Binding Logo}"
                                                       Width="57" Height="36"
                                                       Stretch="Uniform"
                                                       RenderOptions.BitmapScalingMode="HighQuality">
                                                    <!-- ★ 必须把图片裁成圆形（Border 的裁剪是**矩形**的，
                                                         不透明底图会以方角盖住圆的四角）。
                                                         白圆在"图片框 57×36"坐标系里的圆心 = (28.5,18)、半径 34。 -->
                                                    <Image.Clip>
                                                        <EllipseGeometry Center="28.5,18" RadiusX="34" RadiusY="34"/>
                                                    </Image.Clip>
                                                </Image>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <!-- 有台标图时隐藏兜底文字 -->
                                        <DataTrigger Binding="{Binding HasLogo}" Value="True">
                                            <Setter TargetName="TileFallback" Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <!-- 在播：红外圈 -->
                                        <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                            <Setter TargetName="TileRing" Property="BorderBrush" Value="#FF3B3B"/>
                                        </DataTrigger>
                                        <!-- 选中（未播）：青圈 -->
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsSelected}" Value="True"/>
                                                <Condition Binding="{Binding IsPlaying}" Value="False"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter TargetName="TileRing" Property="BorderBrush" Value="#4FC3F7"/>
                                        </MultiDataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- ★ 2026-11-06：状态栏已移到左栏顶部（见视频区 Grid.Row=0），这里不再重复 -->
                </Grid>
            </Border>

            <!-- ★ 2026-11-06：左栏 = 状态栏(顶) / 视频(中) / 节目条 / 控制栏(底)，对齐安卓横屏
                 ★ 2026-11-10（用户："窗口模式视频左边太靠边了"）：整栏留 8px 左边距
                   （全屏时由 ToggleFullscreen 置 0，保持满屏）。 -->
            <Grid x:Name="LeftPane" Grid.Column="0" Margin="8,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>   <!-- 状态栏：左上角，台名 + 播放状态 + 缓冲/错误 -->
                    <RowDefinition Height="*"/>      <!-- 视频区 -->
                    <RowDefinition Height="Auto"/>   <!-- 节目条：▶ 正在播 / ⌛ 接下来 -->
                    <RowDefinition Height="Auto"/>   <!-- 控制栏：播放/停止/音量/全屏 -->
                </Grid.RowDefinitions>

                <!-- ★★ 2026-11-06：状态栏移到**左上角**（对齐安卓 StatusBar / TvStatusBar）★★
                     `StatusText` 的文字与颜色由 MainWindow.SetStatus 统一控制（绿/黄/红三档）。 -->
                <Border x:Name="StatusBar" Grid.Row="0" Background="#16213E" Padding="10,5">
                    <TextBlock x:Name="StatusText" FontSize="12" Foreground="#4CAF50"
                               TextWrapping="NoWrap" Text="就绪 · F/F11 全屏"
                               TextTrimming="CharacterEllipsis"/>
                </Border>

                <!-- ★ 视频区宿主：VLC 与 WebView2 互斥显示（两者都是 airspace 原生子窗口，不能叠） -->
                <Grid x:Name="VideoHost" Grid.Row="1" Background="Black"
                      SizeChanged="VideoHost_SizeChanged">
                    <vlc:VideoView x:Name="VlcView" Visibility="Collapsed" Background="Black"
                                   xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF">
                        <!-- ⚠️ 这里**不要**挂鼠标事件：实测 VLC 的 vout 窗口在覆盖层之上并吃掉了输入 ——
                             双击时 VLC 自己打出 `VoutDisplayEvent 'double click'`，而我们的 VideoArea_* 处理器
                             一行都没打。⇒ 视频区交互统一由**低层鼠标钩子**负责（MainWindow.InstallVideoMouseHook）。 -->
                        <Grid Background="Transparent"/>
                    </vlc:VideoView>
                </Grid>

                <!-- ★★ 2026-11-06：节目条（对齐安卓 EpgStrip）★
                     视频下方一行，显示"正在播 / 接下来"，点击打开全屏节目单弹层。 -->
                <Border Grid.Row="2" x:Name="EpgStrip" Background="#121828" Padding="10,4"
                        Cursor="Hand" MouseLeftButtonUp="EpgStrip_Click">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>   <!-- ★ 2026-11-06：「节目单」按钮（对齐安卓节目条右端） -->
                        </Grid.ColumnDefinitions>
                        <!-- ★ 2026-11-06：用户要求"节目条不要显示频道名，直接显示：正在播出："
                             （台名已经在上方状态栏里了，节目条只放节目信息） -->
                        <TextBlock x:Name="NowPlaying" Grid.Column="0" Text="正在播出：" FontSize="12"
                                   Foreground="#E94560" FontWeight="Bold" VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>
                        <Border Grid.Column="1" x:Name="NowProgBorder" CornerRadius="3" Padding="6,2"
                                Margin="0,0,4,0" VerticalAlignment="Center" Background="Transparent"
                                ToolTip="{Binding ElementName=NowProg, Path=Text}">
                            <ScrollViewer HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Disabled" x:Name="NowProgScroller"
                                          CanContentScroll="False">
                                <TextBlock x:Name="NowProg" Text="" FontSize="11" Foreground="#4CAF50"
                                           TextTrimming="None" FontWeight="Bold"
                                           HorizontalAlignment="Left"/>
                            </ScrollViewer>
                        </Border>
                        <!-- ★ 2026-11-06：用户要求"只显示正在播出，不要即将播出" ⇒ 整块隐藏
                             （控件保留，避免代码里 9 处 NextProg 引用全部改掉） -->
                        <Border Grid.Column="2" x:Name="NextProgBorder" CornerRadius="3" Padding="6,2"
                                VerticalAlignment="Center" Background="Transparent" Visibility="Collapsed"
                                ToolTip="{Binding ElementName=NextProg, Path=Text}">
                            <ScrollViewer HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Disabled" x:Name="NextProgScroller"
                                          CanContentScroll="False">
                                <TextBlock x:Name="NextProg" Text="" FontSize="11" Foreground="#4FC3F7"
                                           TextTrimming="None" HorizontalAlignment="Left"/>
                            </ScrollViewer>
                        </Border>
                        <!-- ★ 2026-11-06：回看/时移时出现，一键回到直播（对齐安卓"回到直播"文字按钮） -->
                        <!-- ★ 2026-11-06：用户反馈"按钮文字不可见"——WPF 默认 Button 模板在深色背景下
                             会沿用系统 Foreground ⇒ 这里显式绑定模板前景 + 加粗，并给出明确的背景/边框 -->
                        <Button Grid.Column="2" x:Name="BtnBackToLive" Click="BtnBackToLive_Click"
                                Visibility="Collapsed" Cursor="Hand" BorderThickness="0"
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                Margin="6,0,0,0" ToolTip="结束回看/时移，回到直播">
                            <Border Background="#E94560" CornerRadius="3" Padding="10,3">
                                <TextBlock Text="⏭ 回到直播" Foreground="White" FontSize="11"
                                           FontWeight="Bold"/>
                            </Border>
                        </Button>
                        <!-- ★★ 2026-11-06（用户要求：与安卓一致）★★ 节目条右端固定一个「节目单 ☰」按钮。
                             文案与安卓 `Strings.EPG_BUTTON` 逐字一致；点节目条本身也能打开，这里给一个明确的入口。
                             ⚠️ 2026-11-06 修：不要用 `CtrlBtnStyle` —— 那个模板是
                                `<Border><ContentPresenter/></Border>`，**没有 `TemplateBinding Padding`**
                                ⇒ 按钮上的 `Padding` 被吞掉 ⇒ 文字贴边（用户："左 padding 太窄，不好看"）。
                             改成与左侧「⏭ 回到直播」**逐字同构**（Button 里套 Border 给 Padding），两者视觉一致。 -->
                        <Button Grid.Column="3" x:Name="BtnEpg" Click="BtnEpg_Click"
                                Cursor="Hand" BorderThickness="0" FontSize="11"
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                Margin="8,0,0,0"
                                ToolTip="查看节目单（前 6 后 3 天；已播完的节目可点「回看」）">
                            <Border Background="#2F6BFF" CornerRadius="3" Padding="10,3">
                                <TextBlock Text="节目单 ☰" Foreground="White" FontSize="11"
                                           FontWeight="Bold"/>
                            </Border>
                        </Button>
                    </Grid>
                </Border>

                <Border x:Name="BottomBar" Grid.Row="3" Background="#16213E" Padding="8,4"
                        CornerRadius="0,0,10,0">
                    <Grid>
                        <!-- ★ 2026-11-06：节目信息已移到独立节目条（Grid.Row=2）⇒ 这里只剩按钮 + 音量 -->
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <!-- 按钮组 -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <Button x:Name="BtnPrev" Content="|◀" Width="34" Height="26" Click="BtnPrev_Click"
                                    Cursor="Hand" FontSize="12" ToolTip="上一频道 (←)"/>
                            <Button x:Name="BtnPlay" Content="▶ 播放" Width="60" Height="26" Click="BtnPlay_Click"
                                    Background="#E94560" Foreground="#FFF" Cursor="Hand"
                                    FontSize="11" Margin="4,0,0,0" ToolTip="播放/暂停 (Enter)"/>
                            <Button x:Name="BtnStop" Content="⏹ 停止" Width="52" Height="26" Click="BtnStop_Click"
                                    Cursor="Hand" FontSize="11" Margin="4,0,0,0" ToolTip="停止播放"/>
                            <Button x:Name="BtnNext" Content="▶|" Width="34" Height="26" Click="BtnNext_Click"
                                    Cursor="Hand" FontSize="12" Margin="4,0,0,0" ToolTip="下一频道 (→)"/>
                        </StackPanel>
                        <!-- 音量 + 静音 + 全屏 -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="BtnMute" Content="🔊" Width="26" Height="26" Click="BtnMute_Click"
                                    Background="Transparent" Foreground="#888" BorderThickness="0"
                                    Cursor="Hand" FontSize="11" Padding="0"
                                    ToolTip="静音/取消静音"/>
                            <Slider x:Name="VolSlider" Width="80" Minimum="0" Maximum="100" Value="80"
                                    ValueChanged="VolSlider_ValueChanged" VerticalAlignment="Center"/>
                            <Button Content="⛶" Width="30" Height="26" Click="BtnFull_Click"
                                    Cursor="Hand" FontSize="14" Margin="4,0,0,0" ToolTip="全屏 (F/F11)"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
    </Border>
</Window>
